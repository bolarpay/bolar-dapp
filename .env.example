# Clave publicable de dashboard.pollar.xyz (pub_testnet_… o pub_mainnet_…)
# Copia este archivo a .env y pega la clave. No commitees .env.
# El prefijo NEXT_PUBLIC_ es obligatorio: sin él Next.js no la envía al navegador.
NEXT_PUBLIC_POLLAR_PUBLISHABLE_KEY=

# Emisor de USDC (Circle). Debe coincidir con la red de la clave publicable.
#   testnet: GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3ZLLFLA5
#   mainnet: GA5ZSEJYB37JRC5AVCIA5MOP4RHTM335X2KGX3IHOJAPP5RE34K4KZVN
NEXT_PUBLIC_USDC_ISSUER=GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3ZLLFLA5

# Cuenta G… que recibe el pago. Debe existir en la red y tener trustline a USDC.
NEXT_PUBLIC_PAYMENT_DESTINATION=

# Clave secreta (sec_…) solo para código de servidor. Nunca con prefijo NEXT_PUBLIC_.
# Hoy ningún archivo la usa.
BACKEND_POLLAR_KEY=
